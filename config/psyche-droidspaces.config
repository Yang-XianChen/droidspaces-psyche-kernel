# Droidspaces on Xiaomi 12X (psyche) — non-GKI Linux 4.19.325
# 基线: Rocky7842/android_kernel_xiaomi_sm8250 @ lineage-23.2
# 用法: cat 本文件 >> arch/arm64/configs/vendor/kona-perf_defconfig
#
# 清单来源: Droidspaces 官方 non-GKI 要求
#   https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md
# 交叉验证: KirinNova/android_kernel_xiaomi_sm8250 (HyperSU 分支 build_kernel.sh
#   的 configure_droidspaces_non_gki()) —— 同 SoC(SM8250)、同内核版本(4.19.325)已跑通
#
# 追加到 kona-perf_defconfig 末尾,靠拼接顺序覆盖掉原有的 "# CONFIG_PID_NS is not set"

# ============================================================
# A. 硬阻断项 —— 不打这三组,容器根本起不来
# ============================================================

# --- A1. PID namespace: 原 defconfig 里被显式关闭,必须打开 ---
CONFIG_PID_NS=y
CONFIG_UTS_NS=y

# --- A2. IPC namespace 及其前置 ---
# IPC_NS 的 Kconfig 依赖是 "depends on (SYSVIPC || POSIX_MQUEUE)",
# 原树两者都没开,所以 IPC_NS 只能是 n。三个一起打开。
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y

# ============================================================
# B. 必需项
# ============================================================
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# cgroup
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y

# 文件系统 / 设备
CONFIG_DEVTMPFS=y                 # 原树未启用 —— 缺则「硬件访问」不可用
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y               # volatile 易失模式
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y              # NixOS 支持

# 固件加载
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# ============================================================
# C. 网络 —— NAT / none 模式必需
# ============================================================
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# 注意:4.19 里这个符号叫 NF_CT_NETLINK;NF_CONNTRACK_NETLINK 是 5.x 之后的名字
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# 4.19 上的旧式别名(上游后来合并了,老树里需要)
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# ------------------------------------------------------------
# Android paranoid networking: 必须关掉
# 开着的话只有 aid_inet(3003)/aid_net_raw(3004)/aid_net_admin(3005)
# 组内的进程才能开 socket,容器里连 ping 都是 "socket: permission denied"
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# ============================================================
# D. 保住 root:KernelSU
# ============================================================
# 必须用 lineage-23.2-ksu 分支构建 —— 该分支把 KernelSU 直接放在 drivers/kernelsu/
# 并已在 drivers/Makefile、drivers/Kconfig 里接线。KernelSU 自身的 Kconfig 是
# `default y`,这里显式写一遍更保险;若用不带 KSU 的分支,该符号不存在会被安全忽略。
CONFIG_KSU=y

# ============================================================
# E. 强烈建议打开的可选项
# ============================================================
CONFIG_USER_NS=y                  # 「Allow Sandboxing」→ 容器内 rootless Docker / Flatpak / bwrap / Chromium
CONFIG_CGROUP_PIDS=y              # --pids-limit

# CONFIG_CFS_BANDWIDTH=y          # --cpus。默认注释:它会改变调度器结构体大小,
#                                 # 若 ROM 存在预编译厂商模块(CONFIG_MODVERSIONS)可能 CRC 不匹配。
#                                 # 确认首次刷入能正常开机后,再单独加这一项重编。

# Macvlan 模式(手机需 USB 以太网卡)
CONFIG_MACVLAN=y

# NAT66:不开则 NAT 容器只有 IPv4
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT_IPV6=y

# 容器内 FUSE 文件系统 / VPN
CONFIG_FUSE_FS=y
CONFIG_TUN=y

# ============================================================
# F. UFW / Fail2Ban 支持(想在容器里跑防火墙才需要)
# ============================================================
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_TARGET_ULOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# ============================================================
# G. 编完后务必校验
# ============================================================
# 1) 这些必须都是 =y(make olddefconfig 之后再查,防止被 Kconfig 依赖回滚):
#    PID_NS IPC_NS UTS_NS SYSVIPC POSIX_MQUEUE NAMESPACES SECCOMP SECCOMP_FILTER
#    CGROUPS CGROUP_DEVICE CGROUP_PIDS MEMCG CGROUP_SCHED FAIR_GROUP_SCHED CGROUP_FREEZER
#    DEVTMPFS OVERLAY_FS NET_NS VETH BRIDGE NETFILTER BRIDGE_NETFILTER NF_CONNTRACK
#    IP_NF_IPTABLES IP_NF_FILTER NF_NAT NF_TABLES IP_NF_TARGET_MASQUERADE
#    NETFILTER_XT_TARGET_TCPMSS NETFILTER_XT_MATCH_ADDRTYPE NF_CT_NETLINK
#    NF_NAT_REDIRECT IP_ADVANCED_ROUTER IP_MULTIPLE_TABLES
#
#    例: grep -E '^CONFIG_(PID_NS|IPC_NS|SYSVIPC|POSIX_MQUEUE|DEVTMPFS|USER_NS)=y' out/.config
#
# 2) 确认没有:CONFIG_ANDROID_PARANOID_NETWORK=y、CONFIG_PERF_HUMANTASK=y
#
# 3) 刷入后开机,装 Droidspaces APK → Settings → Requirements → Check Requirements
